<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>OWN7 · NFL Decision Desk</title>
<style>
:root{
  --ink:#12211f;--muted:#5c6b68;--line:#dfe5e2;--bg:#f6f7f6;--paper:#fff;
  --green:#0f5f4a;--green-soft:#eaf3ef;--amber:#8a5a12;--amber-soft:#fdf4e6;
  --red:#8d2f2f;--red-soft:#fbeeee;--blue:#2c5478;--blue-soft:#eef3f8;
  --radius:10px;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;background:var(--bg);color:var(--ink);
  font:15px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Arial,sans-serif;
  -webkit-font-smoothing:antialiased}
a{color:var(--green);text-decoration:underline;text-decoration-color:rgba(15,95,74,.35);text-underline-offset:2px}
a:hover{text-decoration-color:var(--green);text-underline-offset:3px}
:focus-visible{outline:3px solid #2f7ad1;outline-offset:2px}
.skip{position:absolute;left:-9999px;top:0;background:#fff;padding:10px 16px;z-index:100;
  border:2px solid var(--green);border-radius:0 0 var(--radius) 0}
.skip:focus{left:0}

/* ---------- shell ---------- */
.wrap{max-width:1180px;margin:0 auto;padding:0 22px}
header.top{border-bottom:1px solid var(--line);background:var(--paper);position:sticky;top:0;z-index:40}
.top-inner{display:flex;align-items:center;gap:22px;min-height:62px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:10px;font-weight:700;letter-spacing:-.2px;color:var(--ink)}
.brand .mark{display:grid;place-items:center;width:30px;height:30px;border-radius:8px;
  background:var(--green);color:#fff;font-size:14px}
.brand small{display:block;font-size:10px;letter-spacing:.14em;color:var(--muted);font-weight:600}
.back{font-size:12.5px;color:var(--muted);margin-left:14px;padding-left:15px;border-left:1px solid var(--line);text-decoration:none;white-space:nowrap}
.back:hover{color:var(--green)}
nav.main{display:flex;gap:2px;flex-wrap:wrap;margin-left:auto}
nav.main a{padding:7px 11px;border-radius:8px;font-size:13.5px;font-weight:550;color:var(--muted)}
nav.main a:hover{background:var(--green-soft);color:var(--green);text-decoration:none}
nav.main a[aria-current="page"]{background:var(--green-soft);color:var(--green);font-weight:650}

main{padding:34px 0 60px}
h1{font-size:30px;line-height:1.22;letter-spacing:-.7px;margin:0 0 10px;font-weight:680}
h2{font-size:19px;line-height:1.35;letter-spacing:-.25px;margin:0 0 6px;font-weight:660}
h3{font-size:15px;margin:0 0 4px;font-weight:660}
p{margin:0 0 14px;color:var(--muted);max-width:88ch}
p.lead{font-size:16px;color:#3c4b48;max-width:80ch}
.eyebrow{font-size:10.5px;letter-spacing:.16em;font-weight:700;color:var(--green);
  text-transform:uppercase;margin-bottom:8px}

/* ---------- blocks ---------- */
.card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);
  padding:20px 22px;margin-bottom:18px}
.card h2{margin-top:0}
.grid{display:grid;gap:16px}
.g2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.g3{grid-template-columns:repeat(auto-fit,minmax(215px,1fr))}
.g6{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
.g4{grid-template-columns:repeat(auto-fit,minmax(168px,1fr))}
.stat{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:15px 17px}
.stat .k{font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--muted);font-weight:700}
.stat .v{font-size:26px;font-weight:680;letter-spacing:-.8px;margin:5px 0 2px;font-variant-numeric:tabular-nums}
.stat .n{font-size:12px;color:var(--muted)}
.stat.blank .v{color:#5c6b68;font-weight:500}
.stat .k{min-height:2.4em}

.notice{display:flex;gap:14px;border:1px solid var(--line);border-left:3px solid var(--amber);
  background:var(--amber-soft);border-radius:var(--radius);padding:15px 18px;margin-bottom:20px}
.notice.stop{border-left-color:var(--red);background:var(--red-soft)}
.notice.ok{border-left-color:var(--green);background:var(--green-soft)}
.notice .body p{margin:2px 0 0;color:#4a5854;font-size:13.5px}
.notice strong{font-size:14px}

.badge{display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:20px;
  font-size:11.5px;font-weight:650;white-space:nowrap;border:1px solid transparent}
.badge.good{background:var(--green-soft);color:var(--green);border-color:#cbe2d8}
.badge.warn{background:var(--amber-soft);color:var(--amber);border-color:#f0dcb8}
.badge.stop{background:var(--red-soft);color:var(--red);border-color:#efcaca}
.badge.info{background:var(--blue-soft);color:var(--blue);border-color:#cfdeea}
.badge.mute{background:#f0f2f1;color:var(--muted);border-color:var(--line)}
.dot{width:6px;height:6px;border-radius:50%;background:currentColor;flex:none}

/* ---------- tables ---------- */
.table-wrap{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);
  margin-bottom:22px;overflow:hidden}
.table-head{display:flex;gap:14px;align-items:baseline;padding:14px 18px 10px;flex-wrap:wrap;
  border-bottom:1px solid var(--line)}
.table-head h2{margin:0;font-size:15.5px}
.table-head .meta{font-size:12px;color:var(--muted);margin-left:auto}
.scroll{overflow-x:auto}
.table-wrap.narrow{max-width:1000px}
.table-wrap{max-width:1180px}
table{width:100%}
td,th{overflow-wrap:anywhere}
.table-wrap.narrow .scroll table{table-layout:auto}
td .cv{display:block}
table{border-collapse:collapse;width:100%;font-size:13px}
caption{text-align:left;padding:0 18px 10px;font-size:12px;color:var(--muted)}
th,td{text-align:left;padding:7px 11px;border-bottom:1px solid #eef1ef;vertical-align:top}
thead th{position:sticky;top:0;background:#f9faf9;font-size:11px;letter-spacing:.06em;
  text-transform:uppercase;color:var(--muted);font-weight:700;white-space:nowrap;
  border-bottom:1px solid var(--line)}
tbody tr:hover{background:#fafbfa}
tbody tr:last-child td{border-bottom:none}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums;font-family:var(--mono);font-size:12.5px}
td.blank{background:repeating-linear-gradient(135deg,#f7f8f7,#f7f8f7 5px,#f1f3f1 5px,#f1f3f1 10px);min-width:44px}
td.chips{white-space:normal;min-width:180px}
td.chips .badge{margin:1px 3px 1px 0}
td .id{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:var(--green);font-weight:700;white-space:nowrap}
td .id a,a.id{text-decoration:none}
td .sub{display:block;font-size:11.5px;color:var(--muted);margin-top:2px}
.refs{font-size:11.5px;white-space:normal;display:inline;overflow-wrap:anywhere}
.refs a{margin-right:6px}
.table-note{padding:9px 18px;font-size:12px;color:var(--muted);background:#fbfcfb;
  border-top:1px solid var(--line);margin:0}
.empty{padding:16px 18px;color:var(--muted);font-size:13px}

/* ---------- misc ---------- */
.list{margin:0;padding-left:18px;color:var(--muted);font-size:13.5px}
.list li{margin-bottom:6px}
.list li strong{color:var(--ink)}
.kv{display:grid;grid-template-columns:180px minmax(0,1fr);gap:7px 20px;font-size:13.5px;margin:0}
.kv dd{margin:0;overflow-wrap:anywhere}
@media(max-width:560px){.kv{grid-template-columns:1fr;gap:2px 0}.kv dt{margin-top:9px;color:var(--muted)}.kv dt:first-child{margin-top:0}}
@media(max-width:560px){.table-wrap{max-width:100%}.card,.notice{padding:16px}}
.kv dd{color:#3f4d49}
.kv dt{color:var(--muted);font-weight:600}
.kv dd{margin:0}
code{font-family:var(--mono);font-size:12px;background:#f0f3f1;padding:1px 5px;border-radius:4px}
footer{border-top:1px solid var(--line);padding:22px 0 44px;font-size:12.5px;color:var(--muted);
  display:flex;gap:20px;flex-wrap:wrap;justify-content:space-between}
footer a{color:var(--muted);text-decoration:underline}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
  clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
</head>
